# Copia este archivo como .env y llena con los valores de tu app web en Firebase Console
# (crea un proyecto nuevo, distinto al de gastos-pareja) -> Project Settings -> General -> tu app web

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
